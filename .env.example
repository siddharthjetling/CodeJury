# Copy to .env and fill in. .env is gitignored; never commit real values.

# ── Meta Model API (all reasoning and test generation) ───────────────────────
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# minimal | low | medium | high. Reasoning tokens are billed as output.
META_REASONING_EFFORT=low

# ── uAgent seeds ─────────────────────────────────────────────────────────────
# A seed is the agent's private key: it decides the agent's address and lets
# anyone holding it act as that agent. Use long random values, one per agent.
# Changing a seed changes the agent's address (update config.py afterwards).
ORCHESTRATOR_SEED=
CORRECTNESS_AGENT_SEED=
PERFORMANCE_AGENT_SEED=
SECURITY_AGENT_SEED=
VERDICT_AGENT_SEED=

# ── GitHub (PR links in chat) ────────────────────────────────────────────────
# Only PRs from this repo are verified. Its code must match demo/ (see README).
CODEJURY_GITHUB_REPO=mkg0908/codejury-demo
# Optional: read-only token to avoid GitHub's 60 requests/hour anonymous limit.
GITHUB_TOKEN=
